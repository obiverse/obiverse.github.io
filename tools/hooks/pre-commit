#!/bin/sh
# SEO must match the pages being committed: heads, lastmod (seo.lock.json) and crawl files.
# Installed by port.sh (git config core.hooksPath tools/hooks). Skip once: git commit --no-verify
node tools/seo.mjs --check >/dev/null 2>&1 && exit 0
node tools/seo.mjs --check | grep -E '^stale [^:]'
echo "seo: run  node tools/seo.mjs  then add what it wrote, and commit again"
exit 1
